 					struct device_attribute *attr,
 					char *buf)
@@ -208,9 +218,14 @@ int mt7921_register_device(struct mt792x_dev *dev)
 	dev->pm.stats.last_doze_event = jiffies;
 
 	if (!mt76_is_usb(&dev->mt76) &&
-	    !is_mt7902(&dev->mt76)) {
+	    !is_mt7902(&dev->mt76) &&
+	    !mt7921_disable_ps) {
 		dev->pm.enable_user = true;
 		dev->pm.enable = true;
+	}
+	if (!mt76_is_usb(&dev->mt76) &&
+	    !is_mt7902(&dev->mt76) &&
