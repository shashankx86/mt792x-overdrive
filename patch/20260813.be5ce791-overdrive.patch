diff --git a/agg-rx.c b/agg-rx.c
index 3d34caf7..bf4dd5c1 100644
--- a/agg-rx.c
+++ b/agg-rx.c
@@ -4,11 +4,19 @@
  */
 #include "mt76.h"
 
+/* OVERDRIVE: halve reorder hold (100ms->50ms BE/BK, 40ms->20ms others).
+ * Releases lost-subframe gaps to the stack ~2x faster. */
+static bool mt76_reorder_fast = true;
+module_param_named(reorder_fast, mt76_reorder_fast, bool, 0644);
+MODULE_PARM_DESC(reorder_fast, "halve A-MPDU reorder hold time for lower jitter");
+
 static unsigned long mt76_aggr_tid_to_timeo(u8 tidno)
 {
 	/* Currently voice traffic (AC_VO) always runs without aggregation,
 	 * no special handling is needed. AC_BE/AC_BK use tids 0-3. Just check
 	 * for non AC_BK/AC_BE and set smaller timeout for it. */
+	if (mt76_reorder_fast)
+		return HZ / (tidno >= 4 ? 50 : 20);
 	return HZ / (tidno >= 4 ? 25 : 10);
 }
 
diff --git a/dma.c b/dma.c
index a67880a9..a2acce42 100644
--- a/dma.c
+++ b/dma.c
@@ -1127,7 +1127,11 @@ static void
 mt76_dma_rx_queue_init(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       int (*poll)(struct napi_struct *napi, int budget))
 {
-	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
+	/* OVERDRIVE: 128 for data queue (fewer reschedules under burst),
+	 * 64 for MCU/event queues. Bounded by budget loop above. */
+	int weight = (qid == MT_RXQ_MAIN) ? 128 : 64;
+
+	netif_napi_add_weight(dev->napi_dev, &dev->napi[qid], poll, weight);
 	mt76_dma_rx_fill_buf(dev, &dev->q_rx[qid], false);
 	napi_enable(&dev->napi[qid]);
 }
