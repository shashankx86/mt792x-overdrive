+/* OVERDRIVE: FW power-save / deep-sleep is the largest idle->burst jitter
+ * source after ASPM (83ms idle_timeout + fw-own/driver-own handshake).
+ * Default disabled; reversible at runtime via disable_ps=0/disable_ds=0. */
+static bool mt7921_disable_ps = true;
+module_param_named(disable_ps, mt7921_disable_ps, bool, 0644);
+MODULE_PARM_DESC(disable_ps, "disable firmware power-save");
+static bool mt7921_disable_ds = true;
+module_param_named(disable_ds, mt7921_disable_ds, bool, 0644);
+MODULE_PARM_DESC(disable_ds, "disable deep-sleep");
