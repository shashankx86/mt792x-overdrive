diff --git a/mt76_connac_mcu.c b/mt76_connac_mcu.c
index 2f925d2..d5a3bea 100644
--- a/mt76_connac_mcu.c
+++ b/mt76_connac_mcu.c
@@ -3037,7 +3037,7 @@ s8 mt76_connac_get_rate_power_limit(struct mt76_phy *phy,
 				    struct ieee80211_channel *chan,
 				    struct mt76_power_limits *limits)
 {
-	s8 reg_power, sar_power;
+	s8 reg_power;
 	int tx_power;
 
 	tx_power = 2 * phy->hw->conf.power_level;
@@ -3045,8 +3045,8 @@ s8 mt76_connac_get_rate_power_limit(struct mt76_phy *phy,
 		tx_power = 127;
 
 	reg_power = mt76_connac_get_ch_power(phy, chan, tx_power);
