+	/* OVERDRIVE: bypass SAR capping and use max regulatory channel power */
+	return mt76_get_rate_power_limits(phy, chan, limits, reg_power);
 }
 EXPORT_SYMBOL_GPL(mt76_connac_get_rate_power_limit);
 
